# --- Database (Supabase Session pooler connection string) ---
DATABASE_URL=postgresql+psycopg://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# --- JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- API keys for machine-to-machine access (comma-separated) ---
API_KEYS=replace-me-key-1,replace-me-key-2

# --- CORS: browser origins allowed to call the API (comma-separated) ---
CORS_ORIGINS=http://localhost:3000

# --- Rate limits ---
LOGIN_RATE_LIMIT=5/minute
DEFAULT_RATE_LIMIT=60/minute

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/app.log